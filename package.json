    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.0.0",
    "@primeng/themes": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
